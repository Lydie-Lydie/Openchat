[Unit]
Description=OpenCode headless server (openchat)
After=network-online.target openchat-egress.service
Wants=network-online.target
# Fail closed: never run with web tools while the egress filter is missing.
Requires=openchat-egress.service

[Service]
Type=simple
# Runs as a separate user from the bot so the egress filter
# (openchat-egress.service) can block this process from reaching loopback,
# link-local and private ranges.
User=openchat-oc
Group=openchat-oc
WorkingDirectory=/opt/openchat/workspace
EnvironmentFile=/etc/openchat/openchat.env
Environment=HOME=/home/openchat-oc
ExecStart=/usr/local/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

# RHEL/Rocky: systemd 기본 도메인(init_t)은 아웃바운드 연결과 JIT를 막는다.
SELinuxContext=system_u:system_r:unconfined_service_t:s0

[Install]
WantedBy=multi-user.target
