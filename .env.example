# Identity
BOT_NAME=openchat
COMMAND_NAME=openchat

# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
SELF_USER_ID=
ADMIN_USER_IDS=

# Access control (comma separated). Empty ALLOWED_GUILD_IDS = every server is allowed.
ALLOWED_GUILD_IDS=
# Servers used as style reference. Empty = same as ALLOWED_GUILD_IDS.
STYLE_GUILD_IDS=
# Channels used as style reference. Empty = every channel in STYLE_GUILD_IDS.
STYLE_CHANNEL_IDS=
# Empty MENTION_ALLOWED_USER_IDS = only SELF_USER_ID and ADMIN_USER_IDS can trigger mentions.
MENTION_ALLOWED_USER_IDS=
MENTION_GLOBAL_PER_MIN=20
# true = reply directly in the channel/thread; false = open a thread per mention.
MENTION_REPLY_INLINE=true

# Let the bot use this server's custom emojis (only ones that exist).
EMOJI_ENABLED=true
EMOJI_MAX=30

# Channels (comma separated IDs)
COLLECTOR_CHANNEL_IDS=
SPONTANEOUS_CHANNEL_IDS=
DRY_RUN_CHANNEL_ID=

# OpenCode
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
OPENCODE_MODEL_MENTION=opencode-go/deepseek-v4.1-flash
OPENCODE_MODEL_SPONTANEOUS=opencode-go/deepseek-v4.1-flash
OPENCODE_MODEL_STYLE_SUMMARY=opencode-go/deepseek-v4.1-flash
OPENCODE_TIMEOUT_MS=120000

# Runtime
DB_PATH=./data/openchat.db
LOG_LEVEL=info
NODE_ENV=development
# Quiet hours are evaluated in this timezone. Set it explicitly on servers.
TZ=Asia/Seoul

# Behavior
# DRY_RUN=true: nothing is posted to live channels. Both mention replies and
# spontaneous messages are routed to DRY_RUN_CHANNEL_ID (or only logged) until false.
DRY_RUN=true
# STYLE_LEARNING_ENABLED=false: never build/use the LLM style profile. Prompts then
# rely only on the injected message samples (e.g. a character script).
STYLE_LEARNING_ENABLED=true
# LEXICON_ENABLED=true: inject a deterministic word/ending frequency block, built from
# the corpus with a Korean morphological analyzer (see scripts/lexicon.py).
LEXICON_ENABLED=true
# LEXICON_PATH=./data/lexicon.json
# Fixed persona/instructions prepended to every prompt.
# PERSONA_PROMPT (inline, use \n for newlines) wins; otherwise PERSONA_PATH file is read.
PERSONA_ENABLED=true
PERSONA_PATH=./data/persona.md
PERSONA_PROMPT=
# Auto persona: periodically derive a persona draft from the corpus into a separate file
# (appended after the manual persona; manual content takes priority).
PERSONA_AUTO_ENABLED=true
PERSONA_AUTO_PATH=./data/persona.auto.md
SPONTANEOUS_ENABLED=false
SPONTANEOUS_TICK_MS=600000
SPONTANEOUS_MIN_INTERVAL_SEC=3600
SPONTANEOUS_DAILY_CAP=5
SPONTANEOUS_QUIET_HOURS=00:00-08:00
RETENTION_DAYS=30
